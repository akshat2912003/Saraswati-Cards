# ========================================
# Saraswati Cards — Environment Variables
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
# For Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/saraswati-cards

# JWT Auth (use a long random string)
JWT_SECRET=replace_with_a_long_random_secret

# Admin Credentials (used for initial seeding)
ADMIN_EMAIL=admin@saraswatitcards.com
ADMIN_PASSWORD=change-this-before-use

# WhatsApp (include country code, no + sign, no spaces)
WHATSAPP_NUMBER=919250139863

# Shop Info (used in SEO and contact)
SHOP_NAME=Saraswati Cards
SHOP_TAGLINE=Cards for Every Occasion, Wedding Cards, Birthday Card, Video Invitation, Welcome Board, Shaddi card
SHOP_ADDRESS=Your Shop Address, Prayagraj, Uttar Pradesh, India
SHOP_PHONE=+91-9250139863
SHOP_EMAIL=contact@saraswatitcards.com
SHOP_CITY=Prayagraj
SHOP_STATE=Uttar Pradesh
SHOP_PINCODE=212108

# Domain (for SEO meta tags and WhatsApp message links)

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary media storage (create credentials in the Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=saraswati-cards
